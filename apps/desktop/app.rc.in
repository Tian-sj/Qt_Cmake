#include <windows.h>

// Windows Explorer 使用该资源显示程序图标和 Git 派生的版本信息。
IDI_ICON1 ICON "@PROJECT_SOURCE_DIR@/src/frontend/qt/assets/icons/logo.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @QTCPP_VERSION_MAJOR@,@QTCPP_VERSION_MINOR@,@QTCPP_VERSION_PATCH@,@QTCPP_VERSION_BUILD_RC@
 PRODUCTVERSION @QTCPP_VERSION_MAJOR@,@QTCPP_VERSION_MINOR@,@QTCPP_VERSION_PATCH@,@QTCPP_VERSION_BUILD_RC@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "@QTCPP_ORGANIZATION@\0"
            VALUE "FileDescription", "@QTCPP_APPLICATION_NAME@\0"
            VALUE "FileVersion", "@QTCPP_VERSION_FULL@\0"
            VALUE "InternalName", "@QTCPP_APPLICATION_NAME@\0"
            VALUE "OriginalFilename", "@QTCPP_APPLICATION_NAME@.exe\0"
            VALUE "ProductName", "@QTCPP_APPLICATION_NAME@\0"
            VALUE "ProductVersion", "@QTCPP_VERSION_FULL@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
