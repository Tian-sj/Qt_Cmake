#include <windows.h>

// Windows Explorer 使用该资源显示程序图标和 Git 派生的版本信息。
IDI_ICON1 ICON "@PROJECT_SOURCE_DIR@/apps/desktop/assets/icons/logo.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @CPPPROJECT_VERSION_MAJOR@,@CPPPROJECT_VERSION_MINOR@,@CPPPROJECT_VERSION_PATCH@,@CPPPROJECT_VERSION_BUILD_RC@
 PRODUCTVERSION @CPPPROJECT_VERSION_MAJOR@,@CPPPROJECT_VERSION_MINOR@,@CPPPROJECT_VERSION_PATCH@,@CPPPROJECT_VERSION_BUILD_RC@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "@CPPPROJECT_ORGANIZATION@\0"
            VALUE "FileDescription", "@CPPPROJECT_APPLICATION_NAME@\0"
            VALUE "FileVersion", "@CPPPROJECT_VERSION_FULL@\0"
            VALUE "InternalName", "@CPPPROJECT_APPLICATION_NAME@\0"
            VALUE "OriginalFilename", "@CPPPROJECT_APPLICATION_NAME@.exe\0"
            VALUE "ProductName", "@CPPPROJECT_APPLICATION_NAME@\0"
            VALUE "ProductVersion", "@CPPPROJECT_VERSION_FULL@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
